#!/usr/bin/env bash
#
# fastgen — minimal wrapper for live use.
#
#   fastgen "Artist" "Title"                           # auto-fetch audio via flacfetch
#   fastgen "Artist" "Title" /path/to/audio            # -> "Artist - Title (Fastgen).mp4" in $PWD
#   fastgen "Artist" "Title" https://youtu.be/VIDEO     # fetch that URL's audio via flacfetch
#   fastgen "Artist" "Title" /path/to/audio out.mp4    # explicit output path
#   fastgen "Artist" "Title" --height 720              # extra flags forwarded to fastgen.py
#
# Generates a 480p Star Wars-style scrolling-lyrics karaoke video locally
# (fast instrumental separation + timed lyrics). Upload the mp4 to kjbox yourself.
# Auto-fetch needs FLACFETCH_API_URL/KEY (workspace .envrc via direnv).
# See README.md for flags (--height, --model, --reading, --whisper-model, ...).
#
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo 'Usage: fastgen "Artist" "Title" [audio-or-URL] [output.mp4] [--flags...]' >&2
  echo 'Examples:' >&2
  echo '  fastgen "ABBA" "Waterloo"                         # auto-fetch audio' >&2
  echo '  fastgen "ABBA" "Waterloo" ~/Downloads/waterloo.flac' >&2
  exit 2
fi

ARTIST="$1"; TITLE="$2"; shift 2

# Resolve this script's real directory, following symlinks (so a PATH symlink
# into fastgen/ still finds fastgen.py). Portable — no `readlink -f` (BSD/macOS).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$D/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Optional leading positional: an audio file path OR a URL to fetch.
SRC_ARGS=()
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
  case "$1" in
    http://*|https://*) SRC_ARGS=(--url "$1") ;;
    *)                  SRC_ARGS=("$1") ;;
  esac
  shift
fi

# Pick a Python that has audio-separator. Prefer the nomadkaraoke conda env;
# override with FASTGEN_PYTHON=/path/to/python if needed.
PY="${FASTGEN_PYTHON:-}"
if [ -z "$PY" ]; then
  if [ -x /Users/andrew/miniforge3/envs/nomadkaraoke/bin/python3 ]; then
    PY=/Users/andrew/miniforge3/envs/nomadkaraoke/bin/python3
  else
    PY=python3
  fi
fi

# An optional next positional (not starting with '-') is the output path.
OUT_ARGS=()
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
  OUT_ARGS=(--out "$1"); shift
fi

exec "$PY" "$DIR/fastgen.py" "${SRC_ARGS[@]}" \
  --artist "$ARTIST" --title "$TITLE" "${OUT_ARGS[@]}" "$@"
