[Unit]
Description=NomadPi Overlay Display Engine
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=root
# GTK3 overlay renderer. Connects to the nomad user's X session on :0.
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/nomad/.Xauthority
Environment=GDK_BACKEND=x11
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/nomad/kjbox/desktop/overlay_engine.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
