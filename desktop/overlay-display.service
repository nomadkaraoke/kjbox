[Unit]
Description=NomadPi Overlay Display Engine
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
# Runs as the X session owner (nomad). Uses the SYSTEM python3, which has
# PyGObject (gi) + pycairo + qrcode + PIL; the kj-controller venv does NOT have gi.
User=nomad
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/nomad/.Xauthority
Environment=GDK_BACKEND=x11
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/nomad/kjbox/desktop/overlay_engine.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
