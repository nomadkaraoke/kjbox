-- Karaoke Rotation Display — conky configuration
-- Displays singer queue overlay with true transparent background.
-- Requires: conky-all, a compositor (xcompmgr or picom) for ARGB.

conky.config = {
    background = false,
    own_window = true,
    own_window_type = 'override',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_hints = 'undecorated,below,skip_taskbar,skip_pager',
    double_buffer = true,

    font = 'DejaVu Sans:size=20',
    default_color = 'e0e6f0',

    alignment = 'top_left',
    gap_x = 70,
    gap_y = 60,
    minimum_width = 600,
    maximum_width = 600,

    update_interval = 30,
    use_xft = true,
    xftalpha = 1.0,

    -- Disable default bars/graphs
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
}

conky.text = [[
${font DejaVu Sans:bold:size=40}${color ffffff}ROTATION${color}${font}${alignr}${font DejaVu Sans:size=22}${color 8892a4}${execi 30 /usr/bin/python3 /opt/nomad/kjbox/desktop/rotation_data.py --count-only} singers${color}${font}
${execi 30 /usr/bin/python3 /opt/nomad/kjbox/desktop/rotation_data.py}
]]
