-- Karaoke Rotation Display — conky configuration
-- Full-screen window with wallpaper background for seamless faux transparency.
-- Requires: conky-all

conky.config = {
    background = false,
    own_window = true,
    own_window_type = 'dock',
    own_window_transparent = true,
    own_window_hints = 'undecorated,below,skip_taskbar,skip_pager',
    double_buffer = true,

    font = 'DejaVu Sans:size=20',
    default_color = 'e0e6f0',

    alignment = 'top_left',
    gap_x = 0,
    gap_y = 0,
    minimum_width = 1920,
    maximum_width = 1920,
    minimum_height = 1080,

    update_interval = 3,
    use_xft = true,
    xftalpha = 1.0,

    -- Disable default decorations
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    border_inner_margin = 0,
}

conky.text = [[
${image /opt/nomad/kjbox/desktop/rotation-bg.png -p 0,0 -s 1920x1080}\
${voffset 70}${goto 90}${font DejaVu Sans:bold:size=40}${color ffffff}ROTATION${color}${font}${goto 460}${font DejaVu Sans:size=21}${color 8892a4}${execpi 3 /usr/bin/python3 /opt/nomad/kjbox/desktop/rotation_data.py --stats}${color}${font}
${execpi 3 /usr/bin/python3 /opt/nomad/kjbox/desktop/rotation_data.py}
]]
